{
  "name": "catalog",
  "version": "0.1.0",
  "description": "Paste a Hugging Face model URL, get a plain-English answer about what the model does and whether your machine runs it",
  "type": "module",
  "bin": {
    "catalog": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --experimental-strip-types src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fixtures:refresh": "node --experimental-strip-types scripts/refresh-fixtures.ts"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
